@PACKAGE_INIT@
# ordoConfig.cmake -- generated by configure_package_config_file() from this
# template at build time. Provides ordo::core and, when the installed package
# was built with ORDO_BUILD_QT=ON, ordo::qt.

include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/ordoTargets.cmake")

# ordoTargets.cmake only defines ordo::qt when qt/CMakeLists.txt's
# install(TARGETS ordo_qt EXPORT ordoTargets ...) actually ran -- i.e. the
# installed package had ORDO_BUILD_QT=ON. A core-only install must never
# force a consumer to have Qt6 available, so the find_dependency() call is
# gated on that target actually existing.
if(TARGET ordo::qt)
    find_dependency(Qt6 REQUIRED COMPONENTS Core Widgets)
endif()

check_required_components(ordo)
